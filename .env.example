# BEAST Terminal — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# TokenRouter API key (primary gateway)
HERMES_CUSTOM_API_TOKENROUTER_COM_API_KEY=

# 9Router API key (optional)
HERMES_CUSTOM_9ROUTER_ANZANESIA_UK_API_KEY=

# Exa web search API key (optional, enables /web command)
MCP_EXA_API_KEY=

# DataImpulse proxy (optional, format: user__cr.id / password)
DATAIMPULSE_AUTH=

# Skills API key (local instance)
LOG_API_KEY=hermes-logs-2026

# Port for web terminal
PORT=5000
HOST=0.0.0.0